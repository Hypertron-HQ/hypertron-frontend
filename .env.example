# Copy this file to .env for local development.
# Use real values for all required secrets before running the app.

#
# App
#
# Domain only, without protocol.
NEXT_PUBLIC_APP_DOMAIN=app.hypertron.com
NEXT_PUBLIC_APP_NAME=Hypertron
# Full app origin, used for metadata and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional override for hosted payment link URLs.
NEXT_PUBLIC_PAYMENT_LINK_BASE_URL=

#
# Auth / session
#
# Random long secret for signed session cookies.
AUTH_SECRET=replace_with_a_long_random_secret
# Optional dedicated vault key. If empty, some vault code falls back to AUTH_SECRET.
VAULT_ENCRYPTION_KEY=

#
# Database
#
DATABASE_URL=

#
# Privy
#
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

#
# AI / compliance services
#
COSMOS_AI_URL=http://localhost:8001
NEXT_PUBLIC_COSMOS_AI_URL=
COMPLIANCE_PYTHON_API_URL=
OPENAI_API_KEY=
INGESTION_SECRET=

#
# Stellar / payments
#
# Use testnet for local development, public for mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Fallback destination when a workspace or pool destination is not set.
NEXT_PUBLIC_MERCHANT_RECIPIENT=
# Receive-only pool address for payment links.
NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=
# Private settlement feature flag.
NEXT_PUBLIC_ENABLE_PRIVATE_SETTLEMENT=false
# Contract ids for private settlement / pool manager.
NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID=
POOLMANAGER_CONTRACT_ID=
# Secret used for Soroban commit / payout flows.
SOROBAN_COMMIT_SOURCE_SECRET=
# Optional relayer keys.
NEXT_PUBLIC_RELAYER_PUBLIC_KEY=
RELAYER_SECRET_KEY=
# Optional payout / fee sponsor settings.
POOL_PAYOUT_SECRET=
NEXT_PUBLIC_FEE_SPONSOR_PUBLIC_KEY=
FEE_SPONSOR_SECRET=
FEE_SPONSOR_MAX_FEE_STROOPS=100000
# Optional vault signer overrides.
HYPERTRON_VAULT_SIGNER_PUBLIC=
HYPERTRON_VAULT_SIGNER_SECRET=
# Optional MoneyGram auth secret if those flows are enabled.
MONEYGRAM_AUTH_SECRET=

#
# Circle CCTP contracts
#
# Mainnet
NEXT_PUBLIC_CCTP_MAINNET_STELLAR_TOKEN_MESSENGER=
NEXT_PUBLIC_CCTP_MAINNET_STELLAR_MESSAGE_TRANSMITTER=
NEXT_PUBLIC_CCTP_MAINNET_STELLAR_FORWARDER=
NEXT_PUBLIC_CCTP_MAINNET_STELLAR_USDC_CONTRACT=
NEXT_PUBLIC_CCTP_MAINNET_EVM_TOKEN_MESSENGER=
NEXT_PUBLIC_CCTP_MAINNET_EVM_MESSAGE_TRANSMITTER=
NEXT_PUBLIC_CCTP_MAINNET_EVM_USDC=
NEXT_PUBLIC_CCTP_MAINNET_SOLANA_USDC_MINT=
NEXT_PUBLIC_CCTP_MAINNET_EURC=

# Testnet
NEXT_PUBLIC_CCTP_TESTNET_STELLAR_TOKEN_MESSENGER=
NEXT_PUBLIC_CCTP_TESTNET_STELLAR_MESSAGE_TRANSMITTER=
NEXT_PUBLIC_CCTP_TESTNET_STELLAR_FORWARDER=
NEXT_PUBLIC_CCTP_TESTNET_STELLAR_USDC_CONTRACT=
NEXT_PUBLIC_CCTP_TESTNET_EVM_TOKEN_MESSENGER=
NEXT_PUBLIC_CCTP_TESTNET_EVM_MESSAGE_TRANSMITTER=
NEXT_PUBLIC_CCTP_TESTNET_EVM_USDC=
NEXT_PUBLIC_CCTP_TESTNET_SOLANA_USDC_MINT=
NEXT_PUBLIC_CCTP_TESTNET_EURC=

#
# Optional asset / contract overrides
#
NEXT_PUBLIC_STELLAR_USDC_CONTRACT_MAINNET=
NEXT_PUBLIC_STELLAR_USDC_CONTRACT_TESTNET=
NEXT_PUBLIC_USDC_ISSUER_MAINNET=
NEXT_PUBLIC_USDC_ISSUER_TESTNET=
NEXT_PUBLIC_EURC_ISSUER_MAINNET=
NEXT_PUBLIC_EURC_ISSUER_TESTNET=
