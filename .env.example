# Hypertron core NestJS API (wallet auth + cookies)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Hypertron Payments API (developer API keys, /v1/payments)
NEXT_PUBLIC_DEVELOPER_API_URL=http://localhost:4001

# Stellar network for Freighter checkout (/pay)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Classic asset issuers (required for USDC / EURC classic payments)
NEXT_PUBLIC_USDC_ISSUER=
NEXT_PUBLIC_EURC_ISSUER=

# Hypertron shielded pool (privacy deposit path)
NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=CCXVZOJB67J7ZBQG2UTZCFJ3ZSAMDLSBB62B7KLZNNLO4WQDD3KX6BYP

# Prover assets (served from /public)
# Copy: hypertron-contracts/vk/deposit.pk.bin → public/keys/deposit.pk.bin
# Copy: hypertron-contracts/vk/unshield.pk.bin → public/keys/unshield.pk.bin
# Copy: hypertron-contracts/vk/transfer.pk.bin → public/keys/transfer.pk.bin
# WASM: run `pnpm prover:sync` (keeps public/prover in step with the vendored glue)
NEXT_PUBLIC_DEPOSIT_PK_URL=/keys/deposit.pk.bin
NEXT_PUBLIC_UNSHIELD_PK_URL=/keys/unshield.pk.bin
NEXT_PUBLIC_TRANSFER_PK_URL=/keys/transfer.pk.bin
NEXT_PUBLIC_PROVER_WASM_URL=/prover/hypertron_prover_bg.wasm

# Expected sha256 of each proving key, so a stale cached key fails with a clear
# message instead of producing proofs the chain rejects. Defaults are compiled
# into src/lib/proving-key-digest.ts; set these only when pointing at a
# different deployment. Source: hypertron-contracts/deployments/<network>.json
# → artifacts.<circuit>.pk_sha256
NEXT_PUBLIC_DEPOSIT_PK_SHA256=
NEXT_PUBLIC_UNSHIELD_PK_SHA256=
NEXT_PUBLIC_TRANSFER_PK_SHA256=

# Privacy pool indexer (leaves / nullifiers for unshield)
NEXT_PUBLIC_INDEXER_URL=http://localhost:4002
NEXT_PUBLIC_INDEXER_NETWORK=testnet
